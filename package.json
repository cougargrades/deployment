{
  "name": "deployment",
  "version": "0.0.1",
  "description": "deployment CLI",
  "private": true,
  "types": "build/types/types.d.ts",
  "bin": {
    "deployment": "bin/deployment"
  },
  "scripts": {
    "clean-build": "rm -rf ./build",
    "compile": "tsc -p .",
    "copy-templates": "if [ -e ./src/templates ]; then cp -a ./src/templates ./build/; fi",
    "build": "npm run clean-build && npm run compile && npm run copy-templates",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "tsconfig.json",
    "tslint.json",
    "build",
    "LICENSE",
    "readme.md",
    "docs",
    "bin"
  ],
  "license": "MIT",
  "dependencies": {
    "gluegun": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^12.7.11",
    "@types/jest": "^24.0.18",
    "ts-node": "^8.4.1",
    "typescript": "^3.6.3"
  }
}
